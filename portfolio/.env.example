# Database
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority

# Server-only auth/encryption secrets
PASS_SEC=replace-with-a-long-random-password-encryption-secret
JWT_SEC=replace-with-a-long-random-jwt-secret

# Cloudinary upload credentials
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Public site URLs
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CHATBOT_WIDGET_URL=http://localhost:3000/widget
NEXT_PUBLIC_API_URL=""

# Visit counter service
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8010
NEXT_PUBLIC_VISIT_API_URL=http://localhost:8010

# EmailJS public browser keys
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-emailjs-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# Optional seed script values
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
